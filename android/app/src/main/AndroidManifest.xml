<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:name=".FtaApplication"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="From the Ashes"
        android:icon="@drawable/ic_ashes"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <service
            android:name=".runtime.RuntimeDiagnosticService"
            android:process=":runtime"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User initiated isolated native database compatibility diagnostic with bounded process lifetime" />
        </service>
        <service
            android:name=".runtime.RuntimeRecoveryService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User initiated bounded disposable runtime recovery diagnostic" />
        </service>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
