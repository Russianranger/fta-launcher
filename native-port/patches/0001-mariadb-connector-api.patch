@@ -54,6 +54,32 @@
 set(MYSQL_MINIMUM_VERSION "8.0")
 
 function(check_mysql_version)
+  if(EXISTS "${MYSQL_INCLUDE_DIR}/mariadb_version.h")
+    # This is an explicit Connector/C provider path, not a fabricated MySQL version.
+    include(CheckCXXSourceCompiles)
+    set(CMAKE_REQUIRED_INCLUDES "${MYSQL_INCLUDE_DIR}")
+    set(CMAKE_REQUIRED_LIBRARIES "${MYSQL_LIBRARY}")
+    unset(FTA_MARIADB_API_COMPILES CACHE)
+    check_cxx_source_compiles("
+      #include <mysql.h>
+      #if !defined(MARIADB_PACKAGE_VERSION_ID) || MARIADB_PACKAGE_VERSION_ID < 30300
+      #error MariaDB Connector/C 3.3 or newer is required
+      #endif
+      int main() {
+        MYSQL* handle = mysql_init(nullptr);
+        MYSQL_STMT* statement = nullptr;
+        MYSQL_BIND* bindings = nullptr;
+        mysql_stmt_bind_param(statement, bindings);
+        mysql_close(handle);
+        return mysql_get_client_version() == MARIADB_PACKAGE_VERSION_ID ? 0 : 1;
+      }
+    " FTA_MARIADB_API_COMPILES)
+    if(NOT FTA_MARIADB_API_COMPILES)
+      message(FATAL_ERROR "MariaDB Connector/C headers/library lack required APIs")
+    endif()
+    message(STATUS "Selected MariaDB Connector/C API; SQL compatibility requires a separate database gate")
+    return()
+  endif()
   if(MYSQL_CONFIG)
     execute_process(
       COMMAND "${MYSQL_CONFIG}" --version
