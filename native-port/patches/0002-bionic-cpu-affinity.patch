--- a/src/common/Threading/ProcessPriority.cpp
+++ b/src/common/Threading/ProcessPriority.cpp
@@ -77,7 +77,7 @@
         CPU_ZERO(&mask);
 
         for (unsigned int i = 0; i < sizeof(affinity) * 8; ++i)
-            if (affinity & (1 << i))
+            if (affinity & (uint32(1) << i))
             {
                 CPU_SET(i, &mask);
             }
@@ -89,8 +89,19 @@
         else
         {
             CPU_ZERO(&mask);
-            sched_getaffinity(0, sizeof(mask), &mask);
-            LOG_INFO(logChannel, "Using processors (bitmask, hex): {:x}", *(__cpu_mask*)(&mask));
+            if (sched_getaffinity(0, sizeof(mask), &mask) == 0)
+            {
+                // cpu_set_t is opaque on Bionic; inspect it through the portable macros.
+                uint32 observedAffinity = 0;
+                for (unsigned int i = 0; i < sizeof(affinity) * 8; ++i)
+                    if (CPU_ISSET(i, &mask))
+                        observedAffinity |= (uint32(1) << i);
+                LOG_INFO(logChannel, "Using processors (bitmask, hex): {:x}", observedAffinity);
+            }
+            else
+            {
+                LOG_ERROR(logChannel, "Can't read used processors, error: {}", strerror(errno));
+            }
         }
     }
 
